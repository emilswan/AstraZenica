{
  "permissions": {
    "allow": [
      "Bash(npx next:*)",
      "Bash(lsof -ti:3008)",
      "Bash(xargs kill:*)",
      "Bash(pkill -9 -f \"next dev\")",
      "Read(//tmp/**)",
      "Bash(npx tsc:*)",
      "Bash(curl -v http://localhost:3008)",
      "Bash(curl -s http://localhost:3008/dashboard)",
      "Bash(python3 -c \"import sys; data=sys.stdin.read\\(\\); print\\(data[:3000] if len\\(data\\)>3000 else data\\)\")",
      "Bash(netstat -ano)",
      "Bash(taskkill /PID 23784 /F)",
      "Bash(cmd /c \"taskkill /PID 23784 /F\")",
      "Bash(cmd /c \"taskkill /F /PID 23784 2>&1\")",
      "Bash(powershell -Command \"Stop-Process -Id 23784 -Force\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3008/dashboard)"
    ]
  }
}
